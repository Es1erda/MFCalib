<launch>
  <rosparam command="load" file="$(find MFCalib)/config/calib.yaml" />
  <node 
    pkg="MFCalib"
    type="lidar_camera_calib"
    name="lidar_camera_calib"
    output="screen"
  />
  <node 
    pkg="rviz"
    type="rviz"
    name="rviz"
    args="-d $(find MFCalib)/rviz_cfg/calib.rviz"
  />
</launch>